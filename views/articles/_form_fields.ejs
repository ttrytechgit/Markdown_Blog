<div class="mb-3">
    <label for="title">Title</label>
    <input required value="<%= article.title %>"
    type="text" name="title" id="title"
    class="form-control">
</div>
<div class="mb-3">
    <label for="description">Description</label>
    <textarea name="description" id="description"
    class="form-control"><%= article.description %></textarea>
</div>
<div class="mb-3">
    <label for="markdown">Markdown</label>
    <textarea required name="markdown" id="markdown"
    class="form-control"><%= article.markdown %></textarea>
</div>

<a href="/" class="theme-secondary btn-solid btn-styled">Cancel</a>
<button type="submit" class="theme-primary btn-solid btn-styled">Save</button>